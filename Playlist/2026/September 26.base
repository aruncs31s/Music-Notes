formulas:
  F1: p1_order + rating
views:
  - type: table
    name: Table
    filters:
      and:
        - playlists.contains("September 26")
        - '!file.name.contains("current")'
    groupBy:
      property: avalable_on
      direction: ASC
    order:
      - p1_order
      - file.name
      - tags
      - playlists
      - avalable_on
      - album
      - rating
      - artists
    sort:
      - property: p1_order
        direction: ASC
    columnSize:
      note.p1_order: 102
      file.name: 214
      note.album: 171
      note.avalable_on: 331
  - type: cards
    name: View
    cardSize: 160
    image: note.image
    imageAspectRatio: 0.5
