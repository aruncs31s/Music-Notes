formulas:
  F1: p1_order + rating
views:
  - type: table
    name: Table
    filters:
      and:
        - playlists.contains("September 26")
    order:
      - formula.F1
      - p1_order
      - file.name
      - tags
      - playlists
      - album
      - rating
      - avalable_on
      - file.tags
    sort:
      - property: p1_order
        direction: ASC
    columnSize:
      note.p1_order: 102
      file.name: 214
      note.album: 171
  - type: cards
    name: View
    cardSize: 160
    image: note.image
    imageAspectRatio: 0.5
