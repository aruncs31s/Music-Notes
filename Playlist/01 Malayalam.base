views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("music")
    order:
      - file.name
      - track
      - album
      - year
      - rating
    sort:
      - property: rating
        direction: DESC
  - type: cards
    name: View
    filters:
      and:
        - file.tags.contains("music")
        - file.tags.contains("malayalam")
    order:
      - file.name
      - rating
      - album
      - album artist
    image: note.image
