views:
  - type: table
    name: Table
    filters:
      and:
        - '!available_on.contains("vivo")'
    order:
      - rating
      - file.name
      - tags
      - singers
      - available_on
      - created_at
      - playlists
    sort:
      - property: created_at
        direction: ASC
    columnSize:
      file.name: 478
