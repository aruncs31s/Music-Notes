views:
  - type: table
    name: Table
    filters:
      and:
        - '!file.name.endsWith(".base")'
    order:
      - file.name
      - links
      - tags
      - created_at
      - file.ctime
    sort:
      - property: file.ctime
        direction: ASC
      - property: created_at
        direction: ASC
