views:
  - type: table
    name: Table
    filters:
      and:
        - '!file.name.endsWith(".base")'
        - file.name != "hindi"
        - file.name != "thamil"
        - file.name != "malayalam"
    order:
      - file.name
      - created_at
      - links
      - tags
      - file.ctime
      - file.mtime
    sort:
      - property: created_at
        direction: ASC
      - property: file.mtime
        direction: DESC
      - property: file.ctime
        direction: ASC
